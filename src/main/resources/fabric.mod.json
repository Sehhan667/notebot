{
  "schemaVersion": 1,
  "id": "notebot",
  "version": "${version}",
  "name": "Notebot",
  "description": "Plays noteblock songs from .nbs / .txt files, with an in-game music player UI, nested song folders and favourites.",
  "authors": [
    "AnotherCream",
    "DeepSeek",
    "Notebot contributors (port of MeteorClient's Notebot)"
  ],
  "contact": {
    "homepage": "https://github.com/Sehhan667/notebot",
    "sources": "https://github.com/Sehhan667/notebot",
    "issues": "https://github.com/Sehhan667/notebot/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/notebot/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.notebot.NotebotMod"
    ]
  },
  "depends": {
    "java": ">=25",
    "minecraft": "~26.3",
    "fabricloader": ">=0.19.5",
    "fabric-api": "*"
  }
}
